---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props { entry: CollectionEntry<'work'>; index?: number; }
const { entry, index = 0 } = Astro.props;
const { title, summary, year, role, cover, coverAlt, externalUrl } = entry.data;
const href = externalUrl ?? `/work/${entry.id}/`;
---

<article class="card" style={`--i:${index}`}>
  <a class="card__link" href={href} target={externalUrl ? '_blank' : undefined}>
    <div class="card__media">
      {cover
        ? <Image src={cover} alt={coverAlt ?? ''} widths={[400, 800, 1200]} sizes="(max-width: 760px) 100vw, 50vw" />
        : <div class="card__placeholder" aria-hidden="true"><span>Cover image</span></div>}
    </div>
    <div class="card__body">
      <h3 class="card__title">{title}</h3>
      <p class="card__summary">{summary}</p>
      <p class="card__meta">{role} · {year}</p>
    </div>
  </a>
</article>

<style>
  .card__link {
    display: grid;
    gap: var(--space-s);
    text-decoration: none;
    color: inherit;
  }
  .card__media {
    overflow: hidden;
    border-radius: var(--radius-m);
    background: var(--color-bg-subtle);
    border: 1px solid var(--color-border);
    aspect-ratio: 4 / 3;
  }
  .card__media :global(img) {
    width: 100%; height: 100%; object-fit: cover;
    transition: transform var(--dur-slow) var(--ease-out);
  }
  .card__link:hover .card__media :global(img) { transform: scale(1.03); }
  .card__placeholder {
    display: grid; place-items: center; height: 100%;
    color: var(--color-text-muted); font-family: var(--font-mono);
    font-size: var(--step--1);
  }
  .card__title { font-size: var(--step-2); }
  .card__summary { color: var(--color-text-muted); max-width: 46ch; }
  .card__meta {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--color-text-muted);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }
</style>
