---
/* An image with a caption. Images live in /public/images/<project>/.
   <Figure src="/images/hinge/outcomes.webp" alt="..." lead="Every cell is a failure.">
     The rest of the caption.
   </Figure>
   `lead` is the bolded first phrase. `eager` turns off lazy loading for the
   one image that sits above the fold. */
interface Props {
  src: string;
  alt: string;
  lead?: string;
  eager?: boolean;
}
const { src, alt, lead, eager = false } = Astro.props;
---

<figure>
  <div class="shot"><img src={src} alt={alt} loading={eager ? 'eager' : 'lazy'} decoding="async" /></div>
  <figcaption>{lead && <b>{lead}</b>} <slot /></figcaption>
</figure>
