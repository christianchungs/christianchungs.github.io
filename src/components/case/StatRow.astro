---
/* Four headline numbers. <StatRow items={[{ value: '429', label: 'Postcards coded' }, ...]} /> */
interface Props { items: { value: string; label: string }[]; }
const { items } = Astro.props;
---

<div class="stat-row">
  {items.map((s) => (
    <div class="stat"><b>{s.value}</b><span>{s.label}</span></div>
  ))}
</div>
