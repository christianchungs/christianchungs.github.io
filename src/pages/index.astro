/* ---------- BOULDER BREAKDOWN: one island per project ---------- */
const KX=45,KZ=-78, crag=new THREE.Group(); crag.position.set(KX,0,KZ); scene.add(crag);
const island=new THREE.Group(); crag.add(island);
const kr=mulberry32(21);
const ZF=1.55,YB=-1.35;

function buildRock(P){
 const g=new THREE.IcosahedronGeometry(2.4,2),pa=g.attributes.position,v=new THREE.Vector3(),rn=mulberry32(P.seed);
 const nz=(x,y,z)=>.5*Math.sin(P.f1*x+.3)*Math.cos(1.6*z-.8)+.35*Math.sin(2.7*y+1.1+x)+.22*Math.sin(P.f2*z+2.1*y);
 const CUTS=P.cuts.map(([x,y,z,d])=>[new THREE.Vector3(x,y,z).normalize(),d]);
 for(let i=0;i<pa.count;i++){v.fromBufferAttribute(pa,i);const u=v.clone().normalize();
  const p=P.box,rb=1/Math.pow(Math.abs(u.x)**p+Math.abs(u.y)**p+Math.abs(u.z)**p,1/p);
  v.copy(u).multiplyScalar(2.4*rb*(1+.1*nz(u.x,u.y,u.z)));
  v.x*=P.wide;v.y*=P.tall;v.x+=v.y*P.lean;
  // one side leans out over its own base
  const ang=Math.atan2(v.x,v.z),ov=Math.max(0,Math.cos(ang-P.over)),yn=(v.y+2.4)/4.8;
  const k1=1+P.overAmt*ov*(yn-.45);v.x*=k1;v.z*=k1;
  // a ledge: the rock steps out just under this height, then pulls back in
  const lv=Math.max(0,Math.cos(ang-P.ledgeAng));
  if(v.y>P.ledgeY-.4&&v.y<P.ledgeY+.12){const k2=1+P.ledgeAmt*lv*(1-Math.abs(v.y-P.ledgeY+.14)/.3);v.x*=k2;v.z*=k2}
  for(const [n,d] of CUTS){const k=v.dot(n);if(k>d)v.addScaledVector(n,d-k)}
  const t=(v.y+2.6)/P.step,fr=t-Math.floor(t),ss=fr<.35?0:fr>.65?1:(fr-.35)/.3;
  const k=1-.16*fr; v.x*=k; v.z*=k;
  v.y=v.y*.45+((Math.floor(t)+ss)*P.step-2.6)*.55;
  if(v.y>P.top)v.y=P.top+(v.y-P.top)*.1;
  if(v.z>ZF)v.z=ZF; if(v.y<YB)v.y=YB; v.y-=YB-.02; pa.setXYZ(i,v.x,v.y,v.z)}
 g.computeVertexNormals();
 let FLAT={x0:-1,x1:1,y0:1,y1:2};
 {const xs=[],ys=[];for(let i=0;i<pa.count;i++)if(Math.abs(pa.getZ(i)-ZF)<1e-6){xs.push(pa.getX(i));ys.push(pa.getY(i))}
  xs.sort((a,b)=>a-b);ys.sort((a,b)=>a-b);const q=(A,f)=>A[Math.floor(f*(A.length-1))];
  if(xs.length>3)FLAT={x0:q(xs,.08),x1:q(xs,.92),y0:q(ys,.08),y1:q(ys,.92)}}
 const top=Math.max(...Array.from({length:pa.count},(_,i)=>pa.getY(i)));
 const cols=[],nm=g.attributes.normal,c=new THREE.Color(),cen=new THREE.Vector3();
 for(let i=0;i<pa.count;i+=3){const ny=nm.getY(i),r=rn();
  cen.set((pa.getX(i)+pa.getX(i+1)+pa.getX(i+2))/3,(pa.getY(i)+pa.getY(i+1)+pa.getY(i+2))/3,(pa.getZ(i)+pa.getZ(i+1)+pa.getZ(i+2))/3);
  const ca=Math.atan2(cen.x,cen.z);
  const nearChalk=P.chalk.some(([a,h])=>{let d=Math.abs(ca-a);d=Math.min(d,TAU-d);return d<.28+r*.12&&Math.abs(cen.y-h)<.34+r*.16});
  const ledge=ny>.8&&cen.y<top-.25&&cen.y>.4;
  if(nearChalk&&r<.8)c.setHex(0xECEAE4).offsetHSL(0,0,(r-.5)*.03);
  else if(ledge&&r<.7)c.setHex(0xE1DFD8);
  else if(ny>.6&&cen.y>top-.2&&r<.5)c.setHex(P.lichen);
  else c.setHex(P.rock).offsetHSL(0,0,(r-.5)*.06);
  for(let j=0;j<3;j++)cols.push(c.r,c.g,c.b)}
 g.setAttribute('color',new THREE.Float32BufferAttribute(cols,3));
 const m=new THREE.Mesh(g,new THREE.MeshStandardMaterial({vertexColors:true,flatShading:true,roughness:1}));
 m.castShadow=m.receiveShadow=true;return{m,FLAT}}

const padRay=new THREE.Raycaster();
function buildIsland(P){
 const G=new THREE.Group(),rn=mulberry32(P.seed+7);
 G.add(slab(P.slabR,P.grass,10,P.seed+3,.14));
 for(const [x,z,sc] of P.trees)G.add(pine(x,z,sc,rn));
 for(const [x,z,sc] of P.rocks)G.add(rock(x,z,sc,P.rock,rn));
 for(let i=0;i<9;i++){const t=mesh(new THREE.ConeGeometry(.08,.34,3),P.tuft);const a=rn()*TAU,d=3+rn()*1.8;t.position.set(Math.sin(a)*d,.3,Math.cos(a)*d*.8);G.add(t)}
 const {m,FLAT}=buildRock(P);G.add(m);G.updateMatrixWorld(true);
 // crash pads under the overhanging side, pushed out until they clear the rock
 for(const [i,col] of P.pads.entries()){
  const a=P.over+(i?-.55:.35),dir=new THREE.Vector3(Math.sin(a),0,Math.cos(a));
  let reach=1.4;
  for(const yy of [.2,.5,.9,1.4,1.9]){const o=dir.clone().multiplyScalar(9);o.y=yy;
   padRay.set(o,dir.clone().negate());const h=padRay.intersectObject(m,false)[0];
   if(h)reach=Math.max(reach,Math.hypot(h.point.x,h.point.z))}
  const pad=new THREE.Group();pad.add(mesh(new THREE.BoxGeometry(1.75,.26,1.3),col));
  const st=mesh(new THREE.BoxGeometry(1.77,.27,.18),0x2B2B2B);pad.add(st);
  pad.position.copy(dir).multiplyScalar(reach+.85);pad.position.y=.27;pad.rotation.y=a+(i?.4:-.25);G.add(pad)}
 return{G,FLAT}}

