---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const work = (await getCollection('work', ({ data }) => !data.draft))
  .sort((a, b) => a.data.order - b.data.order);

/* How many slots the work index shows in total. Anything past the real case
   studies renders as "Coming soon...". Drop this to work.length once the third
   project exists. */
const SLOTS = 3;
const placeholders = Math.max(0, SLOTS - work.length);

const capabilities = [
  { label: 'Artifact research', title: 'Learning from what people already made',
    body: '429 real postcards, coded by hand into patterns and themes. The percentages that came out of that shaped what we chose to build.' },
  { label: 'Testing with people', title: 'Watching how people actually use things',
    body: 'Kids aged six to twelve, and adults on dating apps. Moderating, notetaking, consent, task design, and paying attention to what people do as well as what they say.' },
  { label: 'Problem framing', title: "Getting clear on who we're designing for",
    body: 'Two expert interviews helped turn a broad "K-12" brief into an age range we could design for and test against.' },
  { label: 'Interface systems', title: 'One design, three screen sizes',
    body: 'Breakpoints driven by Figma variable modes instead of three copies of every component, so a change lands everywhere at once.' },
  { label: 'Working with stakeholders', title: 'Keeping a sponsor and an eight-year-old happy at the same time',
    body: 'Weekly sponsor reviews, and a partner branding system that gives museums something visible without taking the screen away from the kid drawing on it.' },
  { label: 'Clear reporting', title: 'Being upfront about what the research can tell us',
    body: 'Small samples and friendly crowds are worth naming. Both case studies include a section on the limits of my own research.' },
];
---

<BaseLayout title="Chung — Product Designer">
  <section class="page hero">
    <p class="hero-claim">
      Almost <span class="stamp">13%</span> of kids' postcards to space were showing up blank or barely started, and finding out why changed what we built.
      In Hinge's signup, all ten of our participants got stuck on the same task.
      I enjoy the part of a project where the research starts pointing toward a clear change.{' '}
      <span class="quiet">Product designer at UW Human Centered Design &amp; Engineering.</span>
    </p>
    <div class="chips">
      <span class="chip">Seattle, WA</span>
      <span class="chip">UW HCDE</span>
      <span class="chip">Looking for product design roles</span>
    </div>
  </section>

  <hr class="rule" />

  <section class="page section" id="work">
    <p class="eyebrow">Selected work</p>

    {work.map((entry, i) => (
      <>
        {i > 0 && <hr class="rule rule--gap" />}
        <a class="work-feature" href={`/work/${entry.id}/`}>
          <div class="wf-top">
            <span class="eyebrow">{entry.data.year}</span>
            <span class="eyebrow">{entry.data.client}</span>
          </div>
          <h2 class="wf-title">{entry.data.title}</h2>
          <p class="wf-sub">{entry.data.summary}</p>
          {entry.data.card && (
            <div class="wf-shot">
              <img src={entry.data.card} alt={entry.data.cardAlt ?? ''}
                   loading={i === 0 ? 'eager' : 'lazy'} decoding="async" />
            </div>
          )}
          <span class="wf-go"><span>Read the case study</span><span class="arrow">&rarr;</span></span>
        </a>
      </>
    ))}

    {placeholders > 0 && (
      <div class="soon-list">
        {Array.from({ length: placeholders }).map(() => (
          <div class="soon">
            <h3>Coming soon...</h3>
            <span class="eyebrow">In progress</span>
          </div>
        ))}
      </div>
    )}
  </section>

  <section class="page section">
    <div class="cap-head">
      <h2>What I do on a project</h2>
      <p class="cap-lede">All of this comes from the two projects above.</p>
    </div>
    <div class="cap-grid">
      {capabilities.map((c) => (
        <div class="cap">
          <span class="eyebrow">{c.label}</span>
          <h3>{c.title}</h3>
          <p>{c.body}</p>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .hero { padding-block: clamp(3.5rem, 9vw, 7rem) clamp(2.75rem, 6vw, 4.5rem); }
  .rule { border: 0; border-top: 1px solid var(--color-border); margin: 0; }
  .rule--gap { margin-block: clamp(2.75rem, 5vw, 4.25rem); }
  .soon-list { margin-block-start: clamp(2.5rem, 5vw, 4rem); }
  .cap-head { display: grid; gap: var(--space-xs); margin-block-end: var(--space-l); }
  .cap-lede { color: var(--color-text-muted); font-size: var(--step-1); max-width: var(--measure); }
</style>
