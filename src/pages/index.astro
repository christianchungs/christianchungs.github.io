function showRoom(i){
 if(i===GYM){const[a,b]=gymHTML(activeWall);swap(pL,a);swap(pR,b,.05);swap(hud,hudGym(),.1);swap(tabs,tabsHTML(),.1);gsap.to([pCase,shuf],{autoAlpha:0,duration:.2})}
 else if(i===CAMP){const[a,b]=campHTML(activeItem&&activeItem.userData.key);swap(pL,a);swap(pR,b,.05);swap(hud,'<div>drag to look around the campsite</div>',.1);gsap.to([tabs,pCase,shuf],{autoAlpha:0,duration:.2})}
 else{gsap.to([pL,pR,hud,tabs],{autoAlpha:0,duration:.2});caseIn.innerHTML=CASES[PROJECTS[cragIdx].key];pCase.scrollTop=0;updShuffle();gsap.fromTo(pCase,{autoAlpha:0,y:12},{autoAlpha:1,y:0,duration:.5});gsap.to(shuf,{autoAlpha:1,duration:.4})}}
function updButtons(){const l=(cur+2)%3,r=(cur+1)%3;$('#prev .lbl').textContent=LABEL[l];$('#next .lbl').textContent=LABEL[r];
 $('#prev').setAttribute('aria-label','Go to '+LABEL[l]);$('#next').setAttribute('aria-label','Go to '+LABEL[r])}
function updShuffle(){shuf.querySelector('span').textContent=`${cragIdx+1} / 3 · ${PROJECTS[cragIdx].title}`}

function go(next,opt={}){if(transitioning||next===cur)return;transitioning=true;
 const from=cur;cur=next;updButtons();setActiveItem(null,true);
 gsap.to([pL,pR,hud,tabs,pCase,shuf],{autoAlpha:0,duration:.25});
 const k=Math.round(cam.theta/TAU);cam.theta-=k*TAU;if(from===GYM)st.gym-=k*TAU;
 if(next===GYM){st.gym=PHI(activeWall);st.gym+=TAU*Math.round((cam.theta-st.gym)/TAU)}
 const c=cfg(next),dur=reduce?.01:1.9,dt=thetaOf(next);
 if(opt.project!=null&&next===CRAG){cragIdx=opt.project;showIsland(cragIdx)}
 const tl=gsap.timeline({onComplete(){transitioning=false;showRoom(next)}});
 tl.to(cam,{tx:c.tx,ty:c.ty,tz:c.tz,theta:dt,ax:c.ax,ay:c.ay,duration:dur,ease:'power3.inOut'},0)
   .to(cam,{d:Math.max(cam.d,c.d)*1.5,elev:.55,duration:dur*.5,ease:'power2.out'},0)
   .to(cam,{d:c.d,elev:c.elev,duration:dur*.5,ease:'power2.inOut'},dur*.5);
 if(next===CRAG&&!reduce)tl.add(()=>spinRock(null,true),dur*.62)}
$('#prev').onclick=()=>go((cur+2)%3);
$('#next').onclick=()=>go((cur+1)%3);
document.addEventListener('click',e=>{const t=e.target.closest('[data-wall],[data-case]');if(!t)return;
 if(t.dataset.wall!=null)rotateTo(+t.dataset.wall);else go(CRAG,{project:+t.dataset.case})});

function rotateTo(k){st.lastInput=performance.now();const target=PHI(k)+TAU*Math.round((st.gym-PHI(k))/TAU);st.autoRot=true;st.vel=0;
 gsap.to(st,{gym:target,duration:reduce?.01:1,ease:'power3.inOut',onComplete(){st.autoRot=false}})}
function setWall(k){if(k===activeWall)return;activeWall=k;if(cur!==GYM||transitioning)return;const[a,b]=gymHTML(k);swap(pL,a);swap(pR,b,.06);
 tabs.querySelectorAll('.tab').forEach((t,i)=>t.classList.toggle('on',i===k))}

/* shuffle: spins the whole island and lands on the next project's boulder */
function spinRock(to,arrival){if(spinning)return;spinning=true;const next=to!=null?to:arrival?cragIdx:(cragIdx+1)%3;
 const st2={a:0};let swapped=arrival;
 if(!arrival)gsap.to(pCase,{autoAlpha:0,duration:.25});
 const dur=reduce?.01:1.6;
 const tl=gsap.timeline({onComplete(){spinning=false;island.rotation.y=0;
   if(!arrival){cragIdx=next;caseIn.innerHTML=CASES[PROJECTS[next].key];pCase.scrollTop=0;updShuffle();gsap.fromTo(pCase,{autoAlpha:0,y:12},{autoAlpha:1,y:0,duration:.5})}}});
 tl.to(island.position,{y:.5,duration:dur*.25,ease:'power2.out'},0)
   .to(st2,{a:TAU*3,duration:dur,ease:'power3.inOut',onUpdate(){island.rotation.y=st2.a;
     if(!swapped&&st2.a>TAU*1.5){swapped=true;showIsland(next)}}},0)
   .to(island.position,{y:0,duration:dur*.4,ease:'bounce.out'},dur*.62)}
shuf.onclick=()=>spinRock();

/* ---------- input ---------- */
const ray=new THREE.Raycaster(),ndc=new THREE.Vector2();
let down=null,hovered=null,pinned=null,activeItem=null;
function pick(e){ndc.set(e.clientX/innerWidth*2-1,-(e.clientY/innerHeight)*2+1);ray.setFromCamera(ndc,camera);const h=ray.intersectObjects(targets,false)[0];return h?h.object.userData.item:null}
function setActiveItem(g,silent){if(g===activeItem)return;
 if(activeItem){gsap.to(activeItem.userData,{lift:0,duration:reduce?.01:.6,ease:'power2.inOut'})}
 activeItem=g;if(g)gsap.to(g.userData,{lift:1,duration:reduce?.01:.7,ease:'back.out(1.8)'});
 if(!silent&&cur===CAMP&&!transitioning){const[a,b]=campHTML(g&&g.userData.key);swap(pL,a);swap(pR,b,.04)}}
canvas.addEventListener('pointerdown',e=>{st.lastInput=performance.now();down={x:e.clientX,y:e.clientY,lx:e.clientX,moved:0,type:e.pointerType};canvas.setPointerCapture(e.pointerId);if(cur!==CRAG)canvas.classList.add('grabbing');st.vel=0;st.autoRot=false;gsap.killTweensOf(st)});
canvas.addEventListener('pointermove',e=>{
 if(down){st.lastInput=performance.now();const dx=e.clientX-down.lx;down.lx=e.clientX;down.moved+=Math.abs(dx);
  if(!transitioning){if(cur===GYM){st.gym-=dx*.006;st.vel=-dx*.006}else if(cur===CAMP){st.camp=Math.max(-.7,Math.min(.7,st.camp-dx*.004))}}
  return}
 if(cur===CAMP&&!transitioning&&e.pointerType==='mouse'){hovered=pick(e);canvas.classList.toggle('point',!!hovered);setActiveItem(hovered||pinned)}});
canvas.addEventListener('pointerleave',()=>{if(cur===CAMP&&!transitioning){hovered=null;canvas.classList.remove('point');setActiveItem(pinned)}});
addEventListener('blur',()=>{hovered=null;if(cur===CAMP)setActiveItem(pinned)});
document.addEventListener('pointermove',e=>{if(cur!==CAMP||transitioning||down)return;
 if(e.target!==canvas&&hovered){hovered=null;canvas.classList.remove('point');setActiveItem(pinned)}});
canvas.addEventListener('pointerup',e=>{canvas.classList.remove('grabbing');
 if(down&&down.moved<6&&cur===CAMP&&!transitioning){const g=pick(e);pinned=g;setActiveItem(g)}down=null});
addEventListener('wheel',e=>{if(e.target.closest('#pCase,#pL,#pR'))return;if(cur!==GYM||transitioning)return;e.preventDefault();
 st.autoRot=false;gsap.killTweensOf(st);st.vel=0;st.gym+=e.deltaY*.0022;st.lastWheel=st.lastInput=performance.now()},{passive:false});
addEventListener('keydown',e=>{if(transitioning)return;st.lastInput=performance.now();
 if(cur===GYM&&(e.key==='ArrowLeft'||e.key==='ArrowRight')){rotateTo((activeWall+(e.key==='ArrowRight'?1:2))%3)}
 if(cur===CRAG&&e.key===' '&&document.activeElement===document.body){e.preventDefault();spinRock()}});

/* ---------- loop ---------- */
function resize(){renderer.setSize(innerWidth,innerHeight,false);camera.aspect=innerWidth/innerHeight;camera.updateProjectionMatrix()}
addEventListener('resize',resize);resize();
const clock=new THREE.Clock(),tgt=new THREE.Vector3(),tmp=new THREE.Vector3();
let lastT=0;
function frame(){const t=clock.getElapsedTime(),dt=Math.min(.05,t-lastT);lastT=t;
 // the boulder turns slowly on its own, holds still while you drive it, drifts again after 10s
 const idle=performance.now()-st.lastInput>10000;
 if(!down&&!st.autoRot){st.gym+=st.vel;st.vel*=.9;
  if(Math.abs(st.vel)<.002&&performance.now()-st.lastWheel>180){
   if(idle&&cur===GYM&&!transitioning)st.gym+=dt*.11;
   else{const seg=TAU/3,snap=Math.round(st.gym/seg)*seg;st.gym+=(snap-st.gym)*.08}}}
 const w=((Math.round(st.gym/(TAU/3))%3)+3)%3;setWall(w);
 // camera
 if(!transitioning){const c=cfg(cur);Object.assign(cam,c);cam.theta=thetaOf(cur)}
 tgt.set(cam.tx,cam.ty,cam.tz);
 camera.position.set(tgt.x+Math.sin(cam.theta)*Math.cos(cam.elev)*cam.d,tgt.y+Math.sin(cam.elev)*cam.d,tgt.z+Math.cos(cam.theta)*Math.cos(cam.elev)*cam.d);
 camera.lookAt(tgt);
 const W=innerWidth,H=innerHeight;camera.setViewOffset(W,H,(.5-cam.ax)*W,(.5-cam.ay)*H,W,H);
 sun.position.set(tgt.x+7,15,tgt.z+9);sun.target.position.copy(tgt);
 // campfire + items
 const f=1+Math.sin(t*13)*.08+Math.sin(t*7.3)*.06;flameA.scale.set(1,f,1);flameB.scale.set(1,2-f,1);flameA.rotation.y=t*.8;fireLight.intensity=.8+(f-1)*2;
 for(const g of interactive){const u=g.userData;
  g.position.y=u.base.y+u.lift*1.05+Math.sin(t*2.2)*.05*u.lift;
  if(u.lift>.02)u.spin+=.012*u.lift;else u.spin*=.9;
  g.rotation.y=u.ry+u.spin;g.rotation.z=Math.sin(t*1.7)*.06*u.lift;
  u.marker.position.y=u.base.y+1.1+Math.sin(t*2.4+u.base.x)*.06;u.marker.rotation.y=t;u.marker.visible=u.lift<.3}
 // shuffle button under the rock
 if(cur===CRAG||transitioning){tmp.set(KX,0,KZ+2.9).project(camera);const sx=(tmp.x*.5+.5)*W,sy=(-tmp.y*.5+.5)*H;
  shuf.style.transform=`translate(${Math.round(sx)}px,${Math.round(Math.min(sy+14,H-64))}px) translateX(-50%)`}
 renderer.render(scene,camera);requestAnimationFrame(frame)}

/* ---------- boot ---------- */
updButtons();DECALS.forEach((d,i)=>drawDecal(i));
const[a0,b0]=gymHTML(0);pL.innerHTML=a0;pR.innerHTML=b0;hud.innerHTML=hudGym();tabs.innerHTML=tabsHTML();gsap.set([pCase,shuf],{autoAlpha:0});
Object.assign(cam,cfg(GYM));
if(!reduce){transitioning=true;const c=cfg(GYM);cam.d=c.d*1.7;cam.elev=.7;cam.theta=-.9;
 gsap.to(cam,{d:c.d,elev:c.elev,theta:0,duration:2.2,ease:'power3.out',onComplete(){transitioning=false}})}
document.fonts&&document.fonts.load('700 40px Satoshi').then(()=>document.fonts.load('500 40px Satoshi')).then(()=>{DECALS.forEach((d,i)=>drawDecal(i));window.__posterDraw&&window.__posterDraw()}).catch(()=>{});
frame();
})();
</script>

</body>
</html>
