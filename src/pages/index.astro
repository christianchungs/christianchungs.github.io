---
// The White Room: the whole site is one full-viewport three.js scene.
// Three low-poly biomes (campsite, gym boulder, crag), nav fixed on top.
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<title>Christian Chung · Product Designer</title>
<meta name="description" content="Christian Chung, product designer in Seattle. Case studies on Blue Origin's Club for the Future and a Hinge usability study, set inside a low-poly white room." />
<link rel="preload" href="/fonts/Satoshi-Medium.woff2" as="font" type="font/woff2" crossorigin />

<style is:inline>
@font-face{font-family:'Satoshi';src:url(/fonts/Satoshi-Regular.woff2) format('woff2');font-weight:400;font-display:swap}
@font-face{font-family:'Satoshi';src:url(/fonts/Satoshi-Medium.woff2) format('woff2');font-weight:500 600;font-display:swap}
@font-face{font-family:'Satoshi';src:url(/fonts/Satoshi-Bold.woff2) format('woff2');font-weight:700 800;font-display:swap}
:root{
  --bg:#F7F5F0; --ink:#2B2B2B; --ink-2:#55544F; --ink-3:#8C8A84; --rule:#DEDDD7; --accent:#304C7E;
  --gut:clamp(16px,5.2vw,100px);
  --f:'Satoshi',-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif;
}
html,body{height:100%;overflow:hidden;background:var(--bg);color:var(--ink);font-family:var(--f);-webkit-font-smoothing:antialiased}
#gl{position:fixed;inset:0;width:100%;height:100%;display:block;touch-action:none;cursor:grab}
#gl.grabbing{cursor:grabbing}
#gl.point{cursor:pointer}

.nav{position:fixed;top:0;left:0;right:0;z-index:10;padding:calc(env(safe-area-inset-top,0px)) var(--gut) 0;pointer-events:none}
.nav-in{display:grid;grid-template-columns:1fr auto 1fr;align-items:center;height:100px;border-bottom:1px solid var(--rule)}
.nav a,.nav span{pointer-events:auto;font-size:16px;font-weight:500;color:var(--ink);text-decoration:none}
.nav .logo{font-size:22px;color:var(--accent);font-weight:500;letter-spacing:-.01em}
.nav .r{justify-self:end}
.nav a:hover{color:var(--accent)}

.side{position:fixed;top:50%;z-index:9;transform:translateY(-50%);background:none;border:0;padding:14px 0;font:500 16px/1 var(--f);color:var(--ink);cursor:pointer;display:flex;align-items:center;gap:10px}
.side.l{left:calc(var(--gut) - 16px)}
.side.r{right:calc(var(--gut) - 16px);flex-direction:row-reverse}
.side .chev{font-size:13px;color:var(--ink-3);transition:transform .25s}
.side:hover .chev{color:var(--accent)}
.side.l:hover .chev{transform:translateX(-4px)}
.side.r:hover .chev{transform:translateX(4px)}
.side:focus-visible,.tab:focus-visible,.cta:focus-visible,#shuffle:focus-visible{outline:2px solid var(--accent);outline-offset:4px}

.panel{position:fixed;z-index:5;width:min(340px,26vw);font-size:15px;line-height:1.6;color:var(--ink-2)}
#pL{left:var(--gut);top:150px;max-height:calc(50vh - 190px);overflow:auto}
#pR{right:var(--gut);bottom:84px;max-height:calc(50vh - 110px);overflow:auto}
.eyebrow{font-size:11px;font-weight:700;letter-spacing:.13em;text-transform:uppercase;color:var(--ink-3);display:flex;gap:10px;align-items:center}
.eyebrow i{width:10px;height:10px;display:inline-block;transform:rotate(45deg)}
.panel h2{font-size:clamp(22px,1.9vw,30px);line-height:1.18;font-weight:500;color:var(--ink);letter-spacing:-.012em;margin:14px 0 18px;text-wrap:balance}
.meta{display:grid;grid-template-columns:auto 1fr;gap:6px 18px;margin:0;font-size:14px}
.meta dt{font-size:11px;font-weight:700;letter-spacing:.13em;text-transform:uppercase;color:var(--ink-3);padding-top:3px}
.meta dd{margin:0;color:var(--ink)}
.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin:0 0 18px;border-top:1px solid var(--rule);padding-top:14px}
.stats b{display:block;font-size:28px;font-weight:500;color:var(--accent);letter-spacing:-.02em;line-height:1.1;font-variant-numeric:tabular-nums}
.stats span{display:block;font-size:11px;line-height:1.35;color:var(--ink-3);margin-top:4px}
.panel p{margin:0 0 14px}
.cta{background:none;border:0;padding:0 0 3px;border-bottom:1px solid currentColor;color:var(--accent);font:500 15px var(--f);cursor:pointer}
.cta:hover{border-bottom-width:2px;padding-bottom:2px}
.chip{display:inline-block;font-size:10px;font-weight:700;letter-spacing:.13em;text-transform:uppercase;color:var(--ink-3);border:1px solid var(--rule);padding:3px 7px;border-radius:2px}

#hud{position:fixed;left:50%;bottom:34px;transform:translateX(-50%);z-index:6;display:flex;flex-direction:column;align-items:center;gap:10px;font-size:12px;color:var(--ink-3);text-align:center}
.tabs{display:flex;gap:22px}
.tab{background:none;border:0;padding:4px 0;font:500 14px var(--f);color:var(--ink-3);cursor:pointer;border-bottom:1px solid transparent;display:flex;gap:7px;align-items:center}
.tab i{width:8px;height:8px;transform:rotate(45deg);display:inline-block;opacity:.5}
.tab.on{color:var(--ink);border-bottom-color:var(--ink)}
.tab.on i{opacity:1}

#pCase{position:fixed;z-index:5;left:52%;right:calc(var(--gut) + 190px);top:130px;bottom:0;overflow:auto;padding:20px 8px 90px 0;font-size:15.5px;line-height:1.65;color:var(--ink-2);
  -webkit-mask-image:linear-gradient(to bottom,transparent 0,#000 30px,#000 calc(100% - 80px),transparent 100%);mask-image:linear-gradient(to bottom,transparent 0,#000 30px,#000 calc(100% - 80px),transparent 100%)}
#pCase .in{max-width:620px}
#pCase h2{font-size:clamp(26px,2.4vw,38px);line-height:1.14;font-weight:500;color:var(--ink);letter-spacing:-.015em;margin:14px 0 22px;text-wrap:balance}
#pCase h3{font-size:11px;font-weight:700;letter-spacing:.13em;text-transform:uppercase;color:var(--ink);margin:34px 0 10px}
#pCase p{margin:0 0 12px;max-width:62ch}
#pCase blockquote{margin:14px 0;padding-left:16px;border-left:2px solid var(--accent);color:var(--ink);font-size:17px;line-height:1.5}
#pCase ol{padding-left:0;list-style:none;margin:0;counter-reset:d}
#pCase ol li{counter-increment:d;display:grid;grid-template-columns:28px 1fr;gap:4px;padding:12px 0;border-top:1px solid var(--rule)}
#pCase ol li::before{content:counter(d);font-weight:700;color:var(--accent);font-size:13px;padding-top:2px}
#pCase ol li b{color:var(--ink);font-weight:500}
#pCase ol li em{display:block;font-style:normal;font-size:13px;color:var(--ink-3);margin-top:2px}
#pCase .meta{margin:0 0 8px}
#pCase .note{font-size:13px;color:var(--ink-3);border:1px solid var(--rule);padding:10px 12px;border-radius:2px;margin:0 0 6px}
#pCase .soon{font-size:clamp(36px,4vw,64px);color:var(--ink);font-weight:500;letter-spacing:-.02em;margin-top:22vh}

#shuffle{position:fixed;z-index:7;left:0;top:0;background:var(--ink);color:var(--bg);border:0;border-radius:2px;padding:12px 18px;font:700 11px var(--f);letter-spacing:.14em;text-transform:uppercase;cursor:pointer;display:flex;gap:12px;align-items:center;white-space:nowrap}
#shuffle:hover{background:var(--accent)}
#shuffle span{font-weight:500;letter-spacing:.02em;text-transform:none;font-size:13px;opacity:.7}

@media (max-width:760px){
  .nav-in{height:64px}
  .nav a,.nav span{font-size:14px}.nav .logo{font-size:19px}
  .side{font-size:12px;flex-direction:column!important;gap:4px;top:46%}
  .side.l{left:8px;align-items:flex-start}.side.r{right:8px;align-items:flex-end}
  .side .lbl{max-width:74px;text-align:inherit;line-height:1.2}
  .side.r .lbl{text-align:right}
  .panel{width:auto;left:16px!important;right:16px!important}
  #pL{top:80px;max-height:22vh}
  #pL .meta{display:none}
  .panel h2{font-size:20px;margin:8px 0 0}
  #pR{bottom:92px;max-height:24vh;font-size:14px}
  .stats b{font-size:22px}
  #hud{bottom:18px;width:calc(100% - 32px)}
  .tabs{gap:14px}
  #pCase{left:16px;right:16px;top:52vh;padding-bottom:60px}
  #pCase h2{font-size:24px}
}
@media (prefers-reduced-motion:reduce){*{transition:none!important}}
</style>
</head>
<body>


<canvas id="gl" aria-label="Interactive low-poly scene"></canvas>

<header class="nav"><div class="nav-in">
  <span>seattle, wa</span>
  <a class="logo" href="#" aria-label="chung, home">chung.</a>
  <a class="r" href="#">connect</a>
</div></header>

<button class="side l" id="prev"><span class="chev">&#8249;</span><span class="lbl"></span></button>
<button class="side r" id="next"><span class="chev">&#8250;</span><span class="lbl"></span></button>

<section class="panel" id="pL" aria-live="polite"></section>
<section class="panel" id="pR"></section>
<div id="hud"></div>
<section id="pCase" aria-live="polite"><div class="in"></div></section>
<button id="shuffle">shuffle <span></span></button>

<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
<script is:inline>
(()=>{
const TAU=Math.PI*2, $=s=>document.querySelector(s);
const reduce=matchMedia('(prefers-reduced-motion: reduce)').matches;
const mob=()=>innerWidth<760;
function mulberry32(a){return function(){a|=0;a=a+0x6D2B79F5|0;let t=Math.imul(a^a>>>15,1|a);t=t+Math.imul(t^t>>>7,61|t)^t;return((t^t>>>14)>>>0)/4294967296}}

/* ---------- content ---------- */
const PROJECTS=[
 {key:'postcards',title:'postcards',color:'#304C7E',set:'wall a · set jun 2026',
  headline:'429 postcards, and 12.9% of them blank. That number changed what we built.',
  meta:[['Sponsor','Blue Origin, Club for the Future'],['Context','UW HCDE capstone, 10 weeks'],['Team','4 designers'],['My part','Milestone 3 PM, usability testing']],
  stats:[['429','gallery submissions coded'],['12.9%','blank or barely started'],['7 / 3','breakpoints given / prototyped']],
  blurb:'A space postcard maker for kids 8 to 12. Once we saw who was leaving, the work moved upstream of the canvas.'},
 {key:'hinge',title:'hinge',color:'#E0735A',set:'wall b · set dec 2025',
  headline:'All ten participants could use every feature. None could change an onboarding answer.',
  meta:[['Context','HCDE 417 team study'],['Team','5 researchers'],['Participants','10, ages 18 to 29'],['Note','Independent. Not affiliated with Hinge']],
  stats:[['10/10','failed "adjust a previous answer"'],['6/10','couldn’t find Dating Preferences'],['12','ranked recommendations']],
  blurb:'A usability study of the new-user experience, measured against the app’s own promise: Designed to be Deleted.'},
 {key:'soon',title:'coming soon',color:'#E58FB0',set:'wall c · being set',
  headline:'Coming soon...',meta:[],stats:[],blurb:'This wall is still being set.'}
];

const CASES={
postcards:`<div class="eyebrow"><i style="background:#304C7E"></i>case study · postcards</div>
<h2>429 postcards, and 12.9% of them blank. That number changed what we built.</h2>
<dl class="meta"><dt>Sponsor</dt><dd>Blue Origin, Club for the Future</dd><dt>Context</dt><dd>UW HCDE capstone, 10 weeks, not shipped</dd><dt>Team</dt><dd>Lorelai Harris, Naomi Huang, Chaelynn Lim, Christian Chung</dd></dl>
<h3>The brief</h3>
<p>Club for the Future invites kids to draw postcards that fly to space. The brief said K-12. Our first conversations with Jason Yip and Julie Kientz helped us narrow it: K-12 isn't one audience. We settled on 8 to 12, with a low floor and a high ceiling, and designed slightly above the youngest user.</p>
<h3>The number we kept coming back to</h3>
<p>We coded 429 gallery submissions from missions NS 30 to NS 37. 21.0% had a hand-coloured background. 27.2% had handwritten text. And then there was 12.9%: postcards that were blank, or barely started.</p>
<p>This is where it started to come together for us. A fill tool helps the 21% who already committed. It does nothing for the 12.9% who left. So we moved the work upstream of the canvas.</p>
<h3>What changed</h3>
<ol>
<li><div><b>Background selection before the canvas.</b><em>Trade-off: a plain white page now takes a choice.</em></div></li>
<li><div><b>We removed the onboarding tutorial we'd built.</b><em>Trade-off: legal and privacy copy still needs a better home.</em></div></li>
<li><div><b>Stickers drawn from what kids already draw:</b> planets 18.4%, stars 15.4%, rockets 12.4%.<em>Trade-off: non-space subjects get less help.</em></div></li>
<li><div><b>The trash icon read as delete, so it became "Clear".</b><em>Trade-off: there's no undo behind it yet.</em></div></li>
<li><div><b>We proposed a yes/no survey question to the sponsor</b> in place of NPS: "Did this app make you more excited about space?" The sponsor agreed.<em>Trade-off: no benchmarkable number.</em></div></li>
</ol>
<h3>The theme needed to be louder</h3>
<p>3 of 4 round-one participants didn't register the space framing. P4 described what was missing:</p>
<blockquote>"more rocket and stuff, like everywhere, so you know it's about space."</blockquote>
<p>The launch animation answered it. In round three: "WOW this is super cool."</p>
<h3>What I'd be careful with</h3>
<p>Round one was 4 kids recruited through personal connections, a signal rather than a sample. Discovery Days is an engineering fair, so we didn't treat the booth as closing the theme finding. Nothing here measures long-term STEM interest, which is the program's real goal.</p>
<h3>My part</h3>
<p>Milestone 3 PM. I planned and ran usability testing, co-facilitating round one with Chaelynn Lim, coded NS 31 and NS 32, and made the poster and showcase footage.</p>
<h3>What I'd do differently</h3>
<p>Run the artifact analysis before the expert interviews. Walking into those conversations holding the 12.9% would have bought a session on retention.</p>`,
hinge:`<div class="eyebrow"><i style="background:#E0735A"></i>case study · hinge</div>
<h2>All ten participants could use every feature. None could change an onboarding answer.</h2>
<p class="note">Independent student project. Not affiliated with, sponsored by, or endorsed by Hinge.</p>
<dl class="meta"><dt>Context</dt><dd>UW HCDE 417, fall 2025</dd><dt>Team</dt><dd>Angel Torres-Puga, Christian Chung, Justis Peppin, Wenyi Tsai, Michelle Nguyen</dd></dl>
<h3>Designed to be Deleted</h3>
<p>That's Hinge's motto, and we used it as the bar for the new-user experience. We ran ten sessions with people 18 to 29: eight had never used Hinge, two had been away for six months or more.</p>
<h3>The good news first</h3>
<p>Once people found a feature, all ten could use it. That told us the gap was findability and flexibility, not the interactions themselves.</p>
<h3>The row that's entirely red</h3>
<p>One task was "adjust a previous onboarding answer." All ten participants couldn't complete it. Onboarding asks 20+ questions, one per screen, and none of them has a back button.</p>
<blockquote>"I'd probably close out the app and restart... I'd probably delete the app."</blockquote>
<p>That was P2. Same verb as the brand promise, with the opposite meaning. This is where the pieces came together.</p>
<h3>Other findings</h3>
<ol>
<li><div><b>6/10 couldn't locate Dating Preferences.</b><em>"It's kind of like a small icon on the top left. You would not think that's that." (P6)</em></div></li>
<li><div><b>5/10 couldn't locate Dealbreakers,</b> and 4/10 didn't understand what they do.</div></li>
<li><div><b>7/10 didn't realise how much was premium-limited.</b></div></li>
<li><div><b>4/10 were interrupted by pop-ups</b> often enough to mention it.</div></li>
</ol>
<h3>Where it landed</h3>
<p>12 recommendations, ranked 2 high, 6 medium and 4 low. Each fix comes with trade-offs, and they're worth looking at alongside the recommendations.</p>
<h3>What I'd be careful with</h3>
<p>Several transcripts have no timestamps, so the headline complaint has no duration. Sampling ran through our own networks, and follow-up questions varied by moderator.</p>
<h3>My part</h3>
<p><span class="chip">[Placeholder]</span> Sessions moderated, sessions noted, findings owned.</p>`,
soon:`<div class="eyebrow"><i style="background:#E58FB0"></i>case study · third slot</div><p class="soon">Coming soon...</p>`
};

const ITEMS={
 lantern:{name:'the lantern',color:'#E3B341',tag:'first thing packed',body:'The light that comes out once the fire is down to coals. Where it came from, and the trip it has been on the most.'},
 camera:{name:'the film camera',color:'#2B2B2B',tag:'36 frames at a time',body:'What you shoot on it, the roll you are proudest of, and how having only 36 frames changes how you look before pressing anything.'},
 mug:{name:'the enamel mug',color:'#304C7E',tag:'every morning at camp',body:'Coffee before anyone else is up. A small ritual, and what it says about how you like to start a day, or a project.'},
 sketch:{name:'the sketchbook',color:'#E0735A',tag:'before it goes into figma',body:'Where ideas live before they are ready to be pixels. The page you would show someone first, and why.'},
 chalk:{name:'the chalk bag',color:'#6DB59A',tag:'links to the next two rooms',body:'The thread to the gym and the crag. How climbing started, and what reading a route has taught you about working through a problem.'}
};

/* ---------- three setup ---------- */
const canvas=$('#gl');
const renderer=new THREE.WebGLRenderer({canvas,antialias:true});
renderer.setPixelRatio(Math.min(2,devicePixelRatio));
renderer.setClearColor(0xF7F5F0,1);
renderer.shadowMap.enabled=true; renderer.shadowMap.type=THREE.PCFSoftShadowMap;
const scene=new THREE.Scene();
scene.fog=new THREE.Fog(0xF7F5F0,55,140);
const camera=new THREE.PerspectiveCamera(32,1,0.1,400);

scene.add(new THREE.HemisphereLight(0xffffff,0xd8d2c4,0.62));
const sun=new THREE.DirectionalLight(0xffffff,0.52);
sun.castShadow=true; sun.shadow.mapSize.set(2048,2048);
Object.assign(sun.shadow.camera,{left:-16,right:16,top:16,bottom:-16,near:1,far:60});
sun.shadow.bias=-0.0008; sun.shadow.radius=4;
scene.add(sun,sun.target);

const floor=new THREE.Mesh(new THREE.PlaneGeometry(800,800),new THREE.ShadowMaterial({opacity:0.11}));
floor.rotation.x=-Math.PI/2; floor.receiveShadow=true; scene.add(floor);

const mats={};
const M=(c,o={})=>{const k=c+JSON.stringify(o);return mats[k]||(mats[k]=new THREE.MeshStandardMaterial(Object.assign({color:c,flatShading:true,roughness:1,metalness:0},o)))};
function mesh(g,c,o){const m=new THREE.Mesh(g,M(c,o));m.castShadow=true;m.receiveShadow=true;return m}
function slab(r,c,n,seed,h){const rr=mulberry32(seed),pts=[];for(let i=0;i<n;i++){const a=-i/n*TAU,rad=r*(0.86+rr()*0.22);pts.push(new THREE.Vector2(Math.sin(a)*rad,Math.cos(a)*rad))}
 const g=new THREE.ExtrudeGeometry(new THREE.Shape(pts),{depth:h,bevelEnabled:false});g.rotateX(-Math.PI/2);const m=mesh(g,c);m.castShadow=false;return m}
function pine(x,z,s,rr){const g=new THREE.Group();const t=mesh(new THREE.CylinderGeometry(.1,.14,.7,5),0x7A5A3C);t.position.y=.35;g.add(t);
 for(let i=0;i<3;i++){const c=mesh(new THREE.ConeGeometry(1.05-i*.25,1.3,6),i%2?0x628F6A:0x4F7F5C);c.position.y=.95+i*.62;c.rotation.y=rr()*TAU;g.add(c)}
 g.position.set(x,0,z);g.scale.setScalar(s);return g}
function rock(x,z,s,c,rr){const m=mesh(new THREE.DodecahedronGeometry(s,0),c||0x9E9C95);m.scale.y=.6;m.position.set(x,s*.3,z);m.rotation.set(rr(),rr()*TAU,rr());return m}

/* ---------- GYM: the projects ---------- */
const GX=0, gym=new THREE.Group(); gym.position.x=GX; scene.add(gym);
const LV=[{y:0,r:[3.0,2.65,3.05]},{y:1.9,r:[2.72,3.3,3.12]},{y:3.5,r:[2.2,3.55,2.62]}];
const PHI=k=>k*TAU/3, HALF=0.74;
const R=LV.map((L,l)=>{const o=[];for(let k=0;k<3;k++)for(const s of[-1,1]){const a=PHI(k)+s*HALF+l*0.05;o.push(new THREE.Vector3(Math.sin(a)*L.r[k],L.y,Math.cos(a)*L.r[k]))}return o});
const Pw=[],Pa=[],Pi=[],Pr=[];
function tri(arr,a,b,c,up,inward){const n=new THREE.Vector3().subVectors(b,a).cross(new THREE.Vector3().subVectors(c,a));
 let ok; if(up) ok=n.y>0; else {const m=a.clone().add(b).add(c);m.y=0;ok=n.dot(m)>0; if(inward) ok=!ok}
 ok?arr.push(a,b,c):arr.push(a,c,b)}
// outer panels
for(let l=0;l<2;l++)for(let i=0;i<6;i++){const j=(i+1)%6,arr=i%2?Pa:Pw,a=R[l][i],b=R[l][j],c=R[l+1][j],d=R[l+1][i];tri(arr,a,b,c);tri(arr,a,c,d)}
// hollow: inner shell + plywood rim, no lid
const TH=.14,RI=R.map(ring=>ring.map(v=>{const d=Math.hypot(v.x,v.z);return new THREE.Vector3(v.x*(d-TH)/d,v.y,v.z*(d-TH)/d)}));
for(let l=0;l<2;l++)for(let i=0;i<6;i++){const j=(i+1)%6,a=RI[l][i],b=RI[l][j],c=RI[l+1][j],d=RI[l+1][i];tri(Pi,a,b,c,false,true);tri(Pi,a,c,d,false,true)}
for(let i=0;i<6;i++){const j=(i+1)%6,a=R[2][i],b=R[2][j],c=RI[2][j],d=RI[2][i];tri(Pr,a,b,c,true);tri(Pr,a,c,d,true)}
for(const [arr,c] of [[Pw,0xDCBF90],[Pa,0xCDAB78],[Pi,0xB39062],[Pr,0xE8D3AA]]){const g=new THREE.BufferGeometry().setFromPoints(arr);g.computeVertexNormals();gym.add(mesh(g,c))}

// point on face i (edge i -> i+1), u across, v up
function surf(i,u,v){const j=(i+1)%6,l=v<0.5?0:1,t=(v-l*0.5)*2,A0=R[l][i],B0=R[l][j],A1=R[l+1][i],B1=R[l+1][j];
 const b=A0.clone().lerp(B0,u),tp=A1.clone().lerp(B1,u),p=b.clone().lerp(tp,t);
 const du=B0.clone().sub(A0).lerp(B1.clone().sub(A1),t),dv=tp.clone().sub(b);
 const n=du.cross(dv).normalize(),out=A0.clone().add(B0);out.y=0;if(n.dot(out)<0)n.negate();return{p,n}}

