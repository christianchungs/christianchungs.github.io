---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';

const work = (await getCollection('work', ({ data }) => !data.draft))
  .sort((a, b) => a.data.order - b.data.order);
const featured = work.filter((w) => w.data.featured).slice(0, 3);
const shown = featured.length ? featured : work.slice(0, 3);
---

<BaseLayout title="Chung — Multidisciplinary Designer">
  <section class="page hero">
    <!-- PLACEHOLDER COPY — replace with your real positioning statement. -->
    <p class="eyebrow">Multidisciplinary designer</p>
    <h1 class="hero__line">
      I design products that feel considered, not decorated.
    </h1>
    <p class="hero__sub">
      Currently looking for Product Design and UX roles. Previously
      [placeholder — where you've worked or studied].
    </p>
  </section>

  <section class="page section">
    <div class="section__head">
      <h2>Selected work</h2>
      <a class="section__all" href="/work/">All projects →</a>
    </div>
    <div class="grid">
      {shown.map((entry, i) => <ProjectCard entry={entry} index={i} />)}
    </div>
  </section>
</BaseLayout>

<style>
  .hero { padding-block: var(--space-3xl) var(--space-2xl); display: grid; gap: var(--space-m); }
  .hero__line { max-width: 18ch; }
  .hero__sub { font-size: var(--step-1); color: var(--color-text-muted); max-width: 48ch; }
  .section__head {
    display: flex; align-items: baseline; justify-content: space-between;
    gap: var(--space-m); padding-block-end: var(--space-l);
    border-bottom: 1px solid var(--color-border); margin-block-end: var(--space-l);
  }
  .section__all { font-family: var(--font-mono); font-size: var(--step--1); text-decoration: none; }
  .grid {
    display: grid; gap: var(--space-xl);
    grid-template-columns: repeat(auto-fit, minmax(min(340px, 100%), 1fr));
  }
</style>
