---
// The White Room: the whole site is one full-viewport three.js scene.
// Three low-poly biomes (campsite, gym boulder, crag), nav fixed on top.
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<title>Christian Chung · Product Designer</title>
<meta name="description" content="Christian Chung, product designer in Seattle. Case studies on Blue Origin's Club for the Future and a Hinge usability study, set inside a low-poly white room." />
<link rel="preload" href="/fonts/Satoshi-Medium.woff2" as="font" type="font/woff2" crossorigin />


<style is:inline>
@font-face{font-family:'Satoshi';src:url(/fonts/Satoshi-Regular.woff2) format('woff2');font-weight:400;font-display:swap}
@font-face{font-family:'Satoshi';src:url(/fonts/Satoshi-Medium.woff2) format('woff2');font-weight:500 600;font-display:swap}
@font-face{font-family:'Satoshi';src:url(/fonts/Satoshi-Bold.woff2) format('woff2');font-weight:700 800;font-display:swap}
:root{
  --bg:#F7F5F0; --ink:#2B2B2B; --ink-2:#55544F; --ink-3:#8C8A84; --rule:#DEDDD7; --accent:#304C7E;
  --gut:clamp(16px,5.2vw,100px);
  --f:'Satoshi',-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif;
}
html,body{height:100%;overflow:hidden;background:var(--bg);color:var(--ink);font-family:var(--f);-webkit-font-smoothing:antialiased}
#gl{position:fixed;inset:0;width:100%;height:100%;display:block;touch-action:none;cursor:grab}
#gl.grabbing{cursor:grabbing}
#gl.point{cursor:pointer}

.nav{position:fixed;top:0;left:0;right:0;z-index:10;padding:calc(env(safe-area-inset-top,0px)) var(--gut) 0;pointer-events:none}
.nav-in{display:grid;grid-template-columns:1fr auto 1fr;align-items:center;height:100px;border-bottom:1px solid var(--rule)}
.nav a,.nav span{pointer-events:auto;font-size:16px;font-weight:500;color:var(--ink);text-decoration:none}
.nav .logo{font-size:22px;color:var(--accent);font-weight:500;letter-spacing:-.01em}
.nav .r{justify-self:end}
.nav a:hover{color:var(--accent)}

.side{position:fixed;top:50%;z-index:9;transform:translateY(-50%);background:none;border:0;padding:14px 0;font:500 16px/1 var(--f);color:var(--ink);cursor:pointer;display:flex;align-items:center;gap:10px}
.side.l{left:calc(var(--gut) - 16px)}
.side.r{right:calc(var(--gut) - 16px);flex-direction:row-reverse}
.side .chev{font-size:13px;color:var(--ink-3);transition:transform .25s}
.side:hover .chev{color:var(--accent)}
.side.l:hover .chev{transform:translateX(-4px)}
.side.r:hover .chev{transform:translateX(4px)}
.side:focus-visible,.tab:focus-visible,.cta:focus-visible,#shuffle:focus-visible{outline:2px solid var(--accent);outline-offset:4px}

.panel{position:fixed;z-index:5;width:min(340px,26vw);font-size:15px;line-height:1.6;color:var(--ink-2)}
#pL{left:var(--gut);top:150px;max-height:calc(50vh - 190px);overflow:auto}
#pR{right:var(--gut);bottom:84px;max-height:calc(50vh - 110px);overflow:auto}
.eyebrow{font-size:11px;font-weight:700;letter-spacing:.13em;text-transform:uppercase;color:var(--ink-3);display:flex;gap:10px;align-items:center}
.eyebrow i{width:10px;height:10px;display:inline-block;transform:rotate(45deg)}
.panel h2{font-size:clamp(22px,1.9vw,30px);line-height:1.18;font-weight:500;color:var(--ink);letter-spacing:-.012em;margin:14px 0 18px;text-wrap:balance}
.meta{display:grid;grid-template-columns:auto 1fr;gap:6px 18px;margin:0;font-size:14px}
.meta dt{font-size:11px;font-weight:700;letter-spacing:.13em;text-transform:uppercase;color:var(--ink-3);padding-top:3px}
.meta dd{margin:0;color:var(--ink)}
.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin:0 0 18px;border-top:1px solid var(--rule);padding-top:14px}
.stats b{display:block;font-size:28px;font-weight:500;color:var(--accent);letter-spacing:-.02em;line-height:1.1;font-variant-numeric:tabular-nums}
.stats span{display:block;font-size:11px;line-height:1.35;color:var(--ink-3);margin-top:4px}
.panel p{margin:0 0 14px}
.cta{background:none;border:0;padding:0 0 3px;border-bottom:1px solid currentColor;color:var(--accent);font:500 15px var(--f);cursor:pointer}
.cta:hover{border-bottom-width:2px;padding-bottom:2px}
.chip{display:inline-block;font-size:10px;font-weight:700;letter-spacing:.13em;text-transform:uppercase;color:var(--ink-3);border:1px solid var(--rule);padding:3px 7px;border-radius:2px}

#hud{position:fixed;left:50%;bottom:34px;transform:translateX(-50%);z-index:6;display:flex;flex-direction:column;align-items:center;gap:10px;font-size:12px;color:var(--ink-3);text-align:center}
#tabs{position:fixed;left:50%;top:126px;transform:translateX(-50%);z-index:6;display:flex;gap:26px}
.tabs{display:flex;gap:22px}
.tab{background:none;border:0;padding:4px 0;font:500 14px var(--f);color:var(--ink-3);cursor:pointer;border-bottom:1px solid transparent;display:flex;gap:7px;align-items:center}
.tab i{width:8px;height:8px;transform:rotate(45deg);display:inline-block;opacity:.5}
.tab.on{color:var(--ink);border-bottom-color:var(--ink)}
.tab.on i{opacity:1}

#pCase{position:fixed;z-index:5;left:52%;right:calc(var(--gut) + 190px);top:130px;bottom:0;overflow:auto;padding:20px 8px 90px 0;font-size:15.5px;line-height:1.65;color:var(--ink-2);
  -webkit-mask-image:linear-gradient(to bottom,transparent 0,#000 30px,#000 calc(100% - 80px),transparent 100%);mask-image:linear-gradient(to bottom,transparent 0,#000 30px,#000 calc(100% - 80px),transparent 100%)}
#pCase{scrollbar-width:thin;scrollbar-color:rgba(43,43,43,.16) transparent}
#pCase::-webkit-scrollbar{width:5px}
#pCase::-webkit-scrollbar-track{background:transparent}
#pCase::-webkit-scrollbar-thumb{background:rgba(43,43,43,.16);border-radius:3px}
#pCase:hover::-webkit-scrollbar-thumb{background:rgba(43,43,43,.3)}
.panel{scrollbar-width:thin;scrollbar-color:rgba(43,43,43,.14) transparent}
.panel::-webkit-scrollbar{width:4px}
.panel::-webkit-scrollbar-thumb{background:rgba(43,43,43,.14);border-radius:3px}
#pCase .in{max-width:620px}
#pCase h2{font-size:clamp(26px,2.4vw,38px);line-height:1.14;font-weight:500;color:var(--ink);letter-spacing:-.015em;margin:14px 0 22px;text-wrap:balance}
#pCase h3{font-size:11px;font-weight:700;letter-spacing:.13em;text-transform:uppercase;color:var(--ink);margin:34px 0 10px}
#pCase p{margin:0 0 12px;max-width:62ch}
#pCase blockquote{margin:14px 0;padding-left:16px;border-left:2px solid var(--accent);color:var(--ink);font-size:17px;line-height:1.5}
#pCase ol{padding-left:0;list-style:none;margin:0;counter-reset:d}
#pCase ol li{counter-increment:d;display:grid;grid-template-columns:28px 1fr;gap:4px;padding:12px 0;border-top:1px solid var(--rule)}
#pCase ol li::before{content:counter(d);font-weight:700;color:var(--accent);font-size:13px;padding-top:2px}
#pCase ol li b{color:var(--ink);font-weight:500}
#pCase ol li em{display:block;font-style:normal;font-size:13px;color:var(--ink-3);margin-top:2px}
#pCase .meta{margin:0 0 8px}
#pCase .note{font-size:13px;color:var(--ink-3);border:1px solid var(--rule);padding:10px 12px;border-radius:2px;margin:0 0 6px}
#pCase .soon{font-size:clamp(36px,4vw,64px);color:var(--ink);font-weight:500;letter-spacing:-.02em;margin-top:22vh}

#shuffle{position:fixed;z-index:7;left:0;top:0;background:var(--ink);color:var(--bg);border:0;border-radius:2px;padding:12px 18px;font:700 11px var(--f);letter-spacing:.14em;text-transform:uppercase;cursor:pointer;display:flex;gap:12px;align-items:center;white-space:nowrap}
#shuffle:hover{background:var(--accent)}
#shuffle span{font-weight:500;letter-spacing:.02em;text-transform:none;font-size:13px;opacity:.7}

@media (max-width:760px){
  .nav-in{height:64px}
  .nav a,.nav span{font-size:14px}.nav .logo{font-size:19px}
  .side{top:auto;transform:none;bottom:calc(18px + env(safe-area-inset-bottom,0px));font-size:13px;padding:10px 14px;border:1px solid var(--rule);border-radius:2px;background:var(--bg);z-index:11}
  .side.l{left:16px}.side.r{right:16px}
  .side .lbl{max-width:34vw;line-height:1.2;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .panel{width:auto;left:16px!important;right:16px!important}
  #pL{top:80px;max-height:22vh}
  #pL .meta{display:none}
  .panel h2{font-size:20px;margin:8px 0 0}
  #pR{bottom:118px;max-height:22vh;font-size:14px}
  .stats b{font-size:22px}
  #hud{bottom:78px;width:calc(100% - 32px)}
  #tabs{top:74px;gap:16px}
  #tabs .tab{font-size:12px}
  .tabs{gap:14px}
  #pCase{left:16px;right:16px;top:50vh;bottom:74px;padding-bottom:16px}
  #pCase h2{font-size:24px}
}
@media (prefers-reduced-motion:reduce){*{transition:none!important}}
</style>
</head>
