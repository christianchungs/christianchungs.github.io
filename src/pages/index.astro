function drawDecal(i){const D=DECALS[i],x=D.c.getContext('2d'),W=1024,H=640;x.clearRect(0,0,W,H);
 const F=(w,s)=>`${w} ${s}px Satoshi, Helvetica, Arial, sans-serif`;
 const track=(t,px,py,sp,align)=>{let w=0;for(const ch of t)w+=x.measureText(ch).width+sp;w-=sp;let cx=align==='center'?px-w/2:align==='right'?px-w:px;for(const ch of t){x.fillText(ch,cx,py);cx+=x.measureText(ch).width+sp}};
 x.textBaseline='alphabetic';
 if(i===0){ // postage stamp
  x.fillStyle='#F4F1E8';x.fillRect(60,40,W-120,H-80);
