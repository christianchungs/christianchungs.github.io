  for(let px=60;px<=W-60;px+=36){x.beginPath();x.arc(px,40,rr,0,TAU);x.arc(px,H-40,rr,0,TAU);x.fill()}
  for(let py=40;py<=H-40;py+=36){x.beginPath();x.arc(60,py,rr,0,TAU);x.arc(W-60,py,rr,0,TAU);x.fill()}
  x.globalCompositeOperation='source-over';
  x.fillStyle='#304C7E';x.fillRect(104,84,W-208,H-168);
  // low-poly rocket
  x.save();x.translate(700,330);x.rotate(.5);
  const P=(pts,c)=>{x.fillStyle=c;x.beginPath();pts.forEach(([a,b],k)=>k?x.lineTo(a,b):x.moveTo(a,b));x.closePath();x.fill()};
  P([[0,-150],[40,-70],[0,-70]],'#F4F1E8');P([[0,-150],[-40,-70],[0,-70]],'#DCD7C8');
  P([[-40,-70],[40,-70],[40,70],[-40,70]],'#F4F1E8');P([[-40,-70],[0,-70],[0,70],[-40,70]],'#DCD7C8');
  P([[-40,20],[-80,90],[-40,70]],'#E0735A');P([[40,20],[80,90],[40,70]],'#E0735A');
  x.fillStyle='#304C7E';x.beginPath();x.arc(0,-20,18,0,TAU);x.fill();
  P([[-26,70],[26,70],[0,130]],'#E3B341');P([[-12,70],[12,70],[0,104]],'#F6D46B');x.restore();
  x.fillStyle='rgba(244,241,232,.85)';for(let s=0;s<22;s++){const a=kr();x.beginPath();x.arc(130+a*760,110+kr()*420,1.5+kr()*2.5,0,TAU);x.fill()}
  x.fillStyle='#F4F1E8';x.font=F(700,34);track('429',W-140,150,1,'right');
  x.font=F(700,16);track('CODED',W-140,176,4,'right');
