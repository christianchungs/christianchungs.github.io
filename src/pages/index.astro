  x.fillStyle='#F4F1E8';x.fillRect(150,110,W-300,H-220);
  x.fillStyle='#2B2B2B';x.font=F(500,168);x.textAlign='center';x.fillText('Hinge',W/2,H/2+58);x.textAlign='left';
 } else {
