/* ---------- camera state ---------- */
const ROOMS=['campsite','projects','crag'], LABEL=["christian’s campsite","the projects","the crag"];
const CAMP=0,GYM=1,CRAG=2;
let cur=GYM, transitioning=false, activeWall=0, cragIdx=0, spinning=false;
const st={gym:0,vel:0,camp:0,campVel:0,autoRot:false,lastWheel:0};
const cam={tx:0,ty:1.8,tz:0,d:20,theta:0,elev:.26,ax:.5,ay:.52};
function fitD(radius,f,fv){const t=Math.tan(camera.fov*Math.PI/360),a=camera.aspect;return Math.max(radius/(f*t*a),radius/(fv*t))}
function cfg(i){const m=mob();
 if(i===GYM)return{tx:GX,ty:1.75,tz:0,d:fitD(3.6,m?.78:.36,m?.42:.5),elev:.32,ax:.5,ay:m?.47:.52};
 if(i===CAMP)return{tx:CX,ty:.6,tz:.4,d:fitD(7.4,m?.95:.52,m?.55:.7),elev:.46,ax:.5,ay:m?.47:.56};
 return{tx:KX,ty:1.35,tz:0,d:fitD(3.7,m?.72:.29,m?.34:.5),elev:.12,ax:m?.5:.28,ay:m?.3:.5}}
function thetaOf(i){return i===GYM?st.gym:i===CAMP?st.camp:0}

